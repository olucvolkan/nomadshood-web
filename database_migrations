-- Migration to create base tables for the Nomadshood coliving MVP
-- Generated on 2025-10-18

-- Ensure pgcrypto is available for UUID generation
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- Table: countries
CREATE TABLE IF NOT EXISTS countries (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE,
    iso_code CHAR(2) NOT NULL UNIQUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: colivings
CREATE TABLE IF NOT EXISTS colivings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    country_id INTEGER REFERENCES countries(id) ON DELETE SET NULL,
    name VARCHAR(150) NOT NULL,
    slug VARCHAR(160) NOT NULL UNIQUE,
    description TEXT,
    address TEXT,
    city VARCHAR(100),
    region VARCHAR(100),
    latitude NUMERIC(9,6),
    longitude NUMERIC(9,6),
    number_of_bedrooms SMALLINT,
    number_of_beds SMALLINT,
    number_of_bathrooms SMALLINT,
    price_start NUMERIC(10,2),
    currency CHAR(3),
    open_year_round BOOLEAN DEFAULT FALSE,
    min_stay_days INTEGER,
    wifi_download INTEGER,
    wifi_upload INTEGER,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: coliving_photos
CREATE TABLE IF NOT EXISTS coliving_photos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    coliving_id UUID NOT NULL REFERENCES colivings(id) ON DELETE CASCADE,
    url VARCHAR(255) NOT NULL,
    caption VARCHAR(255),
    sort_order INTEGER DEFAULT 0,
    is_cover BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: coliving_videos
CREATE TABLE IF NOT EXISTS coliving_videos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    coliving_id UUID NOT NULL REFERENCES colivings(id) ON DELETE CASCADE,
    video_url VARCHAR(255) NOT NULL,
    title VARCHAR(150),
    description TEXT,
    sort_order INTEGER DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: coliving_reviews
CREATE TABLE IF NOT EXISTS coliving_reviews (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    coliving_id UUID NOT NULL REFERENCES colivings(id) ON DELETE CASCADE,
    author_name VARCHAR(100) NOT NULL,
    rating SMALLINT NOT NULL CHECK (rating >= 1 AND rating <= 5),
    review_text TEXT NOT NULL,
    review_date DATE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: reservation_requests
CREATE TABLE IF NOT EXISTS reservation_requests (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    coliving_id UUID NOT NULL REFERENCES colivings(id) ON DELETE CASCADE,
    full_name VARCHAR(120) NOT NULL,
    email VARCHAR(150) NOT NULL,
    phone_number VARCHAR(30),
    check_in_date DATE NOT NULL,
    check_out_date DATE NOT NULL,
    number_of_guests INTEGER DEFAULT 1,
    message TEXT,
    status VARCHAR(20) NOT NULL DEFAULT 'pending',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: coliving_near_places
CREATE TABLE IF NOT EXISTS coliving_near_places (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    coliving_id UUID NOT NULL REFERENCES colivings(id) ON DELETE CASCADE,
    name VARCHAR(120) NOT NULL,
    category VARCHAR(50) NOT NULL,
    distance_minutes INTEGER NOT NULL,
    description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: coliving_contacts
CREATE TABLE IF NOT EXISTS coliving_contacts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    coliving_id UUID NOT NULL REFERENCES colivings(id) ON DELETE CASCADE,
    type VARCHAR(50) NOT NULL,
    value TEXT NOT NULL,
    label VARCHAR(100),
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table: coliving_facilities
CREATE TABLE IF NOT EXISTS coliving_facilities (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    coliving_id UUID NOT NULL REFERENCES colivings(id) ON DELETE CASCADE,
    facility_name VARCHAR(120) NOT NULL,
    description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
